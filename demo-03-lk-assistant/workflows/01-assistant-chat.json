{
    "_comment": "ЗАГОТОВКА. Используй ноду @n8n/n8n-nodes-langchain AI Agent. Собирается в UI по спецификации.",
    "_spec": {
        "name": "01 — Assistant Chat",
        "description": "Вебхук, на входе JWT+message, AI Agent с tools, ответ клиенту.",
        "nodes": [
            {
                "step": 1,
                "name": "Webhook",
                "type": "n8n-nodes-base.webhook",
                "path": "lk-assistant",
                "method": "POST",
                "responseMode": "lastNode",
                "expected_body": {
                    "tenant_id": "number (из svc_lk, уже верифицирован)",
                    "user_id": "number",
                    "role": "string",
                    "session_id": "uuid",
                    "message": "string",
                    "ai_tier": "basic | premium",
                    "auth_token": "string (передаём tool'ам)"
                }
            },
            {
                "step": 2,
                "name": "Validate Input",
                "type": "code (JavaScript)",
                "purpose": "Проверяем обязательные поля, если чего-то нет — сразу короткий ответ с ошибкой"
            },
            {
                "step": 3,
                "name": "Tier Switch",
                "type": "switch",
                "condition": "{{ $json.ai_tier }}",
                "branches": ["basic", "premium"]
            },
            {
                "step": "4a",
                "branch": "basic",
                "name": "AI Agent (Ollama)",
                "type": "@n8n/n8n-nodes-langchain.agent",
                "settings": {
                    "agentType": "toolsAgent",
                    "llm": "Ollama Chat Model (qwen2.5:7b)",
                    "systemPrompt": "см. snippets/SNIPPETS.md → system-prompt",
                    "memory": "Postgres Chat Memory (session_id)",
                    "tools": "см. ниже"
                }
            },
            {
                "step": "4b",
                "branch": "premium",
                "name": "AI Agent (Claude/GPT)",
                "type": "@n8n/n8n-nodes-langchain.agent",
                "settings": {
                    "llm": "Anthropic Claude (claude-sonnet-4-5) или OpenAI GPT-4o",
                    "tools": "те же"
                }
            },
            {
                "step": 5,
                "name": "Extract Response",
                "type": "code",
                "purpose": "Достаём финальный ответ + список использованных tool'ов"
            },
            {
                "step": 6,
                "name": "Save to History",
                "type": "postgres (insert)",
                "table": "lk_assistant.chat_messages"
            },
            {
                "step": 7,
                "name": "Respond to Webhook",
                "type": "n8n-nodes-base.respondToWebhook",
                "body": { "answer": "{{ $json.answer }}", "tools_used": "{{ $json.tools_used }}", "session_id": "{{ $json.session_id }}" }
            }
        ],
        "tools": [
            {
                "name": "get_orders",
                "description": "Получить список заказов текущего пользователя. Можно фильтровать по статусу (new/in_progress/in_transit/delivered/error) или по номеру.",
                "type": "HTTP Request Tool",
                "method": "GET",
                "url": "http://mock-svc-lk:3100/orders",
                "query_params": "{status}, {number}",
                "headers": { "authorization": "Bearer {{ $('Webhook').first().json.auth_token }}" }
            },
            {
                "name": "get_invoices",
                "description": "Получить список счетов. Можно фильтровать по статусу (paid/pending/error) или по номеру счёта.",
                "type": "HTTP Request Tool",
                "method": "GET",
                "url": "http://mock-svc-lk:3100/invoices",
                "headers": { "authorization": "Bearer {{ $('Webhook').first().json.auth_token }}" }
            },
            {
                "name": "integration_status",
                "description": "Получить текущий статус обмена данными (работает/деградация/сбой) и количество ошибок за сутки.",
                "type": "HTTP Request Tool",
                "method": "GET",
                "url": "http://mock-svc-lk:3100/integration/status",
                "headers": { "authorization": "Bearer {{ $('Webhook').first().json.auth_token }}" }
            },
            {
                "name": "search_documents",
                "description": "Поиск по документам клиента (регламенты, инструкции, договоры). Возвращает релевантные куски текста.",
                "type": "Workflow Tool (вызывает под-воркфлоу)",
                "sub_workflow": "search-docs-subworkflow (описан отдельно)",
                "input_schema": { "query": "string (вопрос на естественном языке)", "tenant_id": "number" }
            }
        ],
        "important": [
            "tenant_id в SQL-запросах tool'ов ВСЕГДА подставляется из контекста webhook'а, а НЕ из параметра, который выбрал LLM. Иначе агент сможет обойти изоляцию.",
            "Все tool'ы проверяют authorization header через mock-svc-lk, который верифицирует JWT и отбрасывает запросы к чужому tenant'у.",
            "Если tool возвращает пустой массив — системный промпт явно требует сказать 'не найдено', а не придумывать.",
            "При отказе LLM вызвать tool (галлюцинация) — респонс помечается флагом tools_used=[] в ответе клиенту, можно отслеживать."
        ]
    }
}
