# ============================================================================
# Обязательные переменные
# ============================================================================

# Ключ шифрования credentials в n8n (генерируется автоматически через make init)
N8N_ENCRYPTION_KEY=CHANGE_ME

# ============================================================================
# Модели Ollama (можно оставить по умолчанию)
# ============================================================================

OLLAMA_MODEL_CHAT=qwen2.5:7b
OLLAMA_MODEL_CODE=qwen2.5-coder:7b

# ============================================================================
# Бэкенд для уведомлений. Варианты: mattermost | email | webhook
# ============================================================================

CHAT_BACKEND=mattermost
MATTERMOST_URL=http://mattermost:8065
MATTERMOST_BOT_TOKEN=

# ============================================================================
# Mattermost (создаётся автоматически через make init)
# ============================================================================

MM_ADMIN_EMAIL=admin@demo.local
MM_ADMIN_USER=admin
MM_ADMIN_PASS=Demo_secret1
MM_TEAM_NAME=demo

# SMTP (если CHAT_BACKEND=email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
